# Copy to .env and adjust.

# Postgres connections. In production, the Vercel Postgres (Neon) integration
# injects both automatically — nothing to set there.
# Locally, point them at your own Postgres (see README: createdb cpd_polls_dev).
POSTGRES_PRISMA_URL="postgresql://<user>@localhost:5432/cpd_polls_dev?sslmode=disable"
POSTGRES_URL_NON_POOLING="postgresql://<user>@localhost:5432/cpd_polls_dev?sslmode=disable"

# Shared passphrase residents use to submit proposals.
RESIDENT_CODE="casa-do-povo"

# Admin credentials for /admin (member management).
ADMIN_USER="admin"
ADMIN_PASSWORD="muda-me"
