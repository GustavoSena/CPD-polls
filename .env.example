# Copy to .env and adjust.

# Postgres connections. In production, the Vercel Postgres (Neon) integration
# injects both automatically — nothing to set there.
# Locally, point them at your own Postgres (see README: createdb cpd_polls_dev).
POSTGRES_PRISMA_URL="postgresql://<user>@localhost:5432/cpd_polls_dev?sslmode=disable"
POSTGRES_URL_NON_POOLING="postgresql://<user>@localhost:5432/cpd_polls_dev?sslmode=disable"

# Shared passphrase residents use to submit proposals.
RESIDENT_CODE="casa-do-povo"

# Who can open /admin (member management): comma-separated emails of members.
# They sign in at /entrar with an emailed code like everyone else.
ADMIN_EMAILS="tu@exemplo.pt"

# Email sign-in codes are sent from a Gmail account using an app password
# (https://myaccount.google.com/apppasswords — needs 2-step verification).
# Without these in dev, the code is printed in the terminal instead.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional sender name/address, e.g. "CPD <you@gmail.com>".
# EMAIL_FROM=""
# Alternative to Gmail if you get a domain: RESEND_API_KEY="" (with EMAIL_FROM
# on a domain verified in Resend). Gmail is used when both are set.
