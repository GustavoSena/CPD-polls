// CPD polls database schema.
//
// Postgres everywhere: a local database in dev, Vercel Postgres (Neon)
// in production — see README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (pgbouncer) for runtime queries; direct connection for migrations.
  // Both are injected by the Vercel Postgres (Neon) integration.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Proposal {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  imageId     String?
  createdAt   DateTime     @default(now())
  deadline    DateTime
  options     Option[]
  votes       Vote[]
  memberVotes MemberVote[]
}

// A community member. Identified by personal secret links (/m/[token]),
// distributed by the admin — no accounts, no passwords.
model Member {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  links       MemberLink[]
  votes       MemberVote[]
  suggestions Suggestion[]
}

// One personal secret link. A member can hold several — one per device —
// so the same person is recognized on phone, laptop, etc. Revoking one
// link (e.g. a lost phone) leaves the member's other devices working.
model MemberLink {
  id        String   @id @default(cuid())
  token     String   @unique
  label     String   @default("")
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String

  @@index([memberId])
}

// Records THAT a member voted on a proposal — never WHAT they voted.
// The choice itself lives in Vote, with no link back to the member.
model MemberVote {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String

  @@unique([memberId, proposalId])
}

model Option {
  id          String   @id @default(cuid())
  text        String
  description String   @default("")
  imageId     String?
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId  String
  votes       Vote[]
}

// Uploaded images, stored in the database so local dev and production
// work the same way (no external file storage). Served via /media/[id].
model Media {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

// A free-form suggestion from a recognized member. Unlike votes,
// suggestions are signed: the author's name is shown next to the text.
model Suggestion {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String

  @@index([memberId])
}

// A vote stores no voter identity — fully anonymous.
model Vote {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId   String
}
