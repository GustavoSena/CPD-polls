// CPD polls database schema.
//
// Postgres everywhere: a local database in dev, Vercel Postgres (Neon)
// in production — see README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (pgbouncer) for runtime queries; direct connection for migrations.
  // Both are injected by the Vercel Postgres (Neon) integration.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Proposal {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  imageId     String?
  createdAt   DateTime     @default(now())
  deadline    DateTime
  options     Option[]
  votes       Vote[]
  memberVotes MemberVote[]
}

// A community member. Signs in with a one-time code sent to their email;
// each signed-in device gets its own MemberLink. No passwords. Members
// without an email can still use a personal secret link (/m/[token]).
model Member {
  id          String       @id @default(cuid())
  name        String
  // Stored lowercased. Optional so members added before email login keep
  // working through their links until the admin fills it in.
  email       String?      @unique
  createdAt   DateTime     @default(now())
  links       MemberLink[]
  loginCodes  LoginCode[]
  votes       MemberVote[]
  suggestions Suggestion[]
  // Secret Santa: who this member gives to / receives from, and their wishes.
  givingTo      SecretSantaAssignment[] @relation("giver")
  receivingFrom SecretSantaAssignment[] @relation("receiver")
  wishlistItems WishlistItem[]
}

// One recognized device. Created when the member signs in with an email
// code (the browser keeps the token in a cookie), or by the admin as a
// personal secret link (/m/[token]). A member can hold several, so the same
// person is recognized on phone, laptop, etc. Revoking one (e.g. a lost
// phone) signs that device out and leaves the others working.
model MemberLink {
  id        String   @id @default(cuid())
  token     String   @unique
  label     String   @default("")
  // true when created by email sign-in (signing out deletes it); false for
  // a link the admin created and handed out.
  fromLogin Boolean  @default(false)
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String

  @@index([memberId])
}

// A pending one-time sign-in code. Only a hash of the code is stored; it
// expires after a few minutes and allows a handful of wrong guesses.
model LoginCode {
  id        String   @id @default(cuid())
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String

  @@index([memberId])
}

// Records THAT a member voted on a proposal — never WHAT they voted.
// The choice itself lives in Vote, with no link back to the member.
model MemberVote {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String

  @@unique([memberId, proposalId])
}

model Option {
  id          String   @id @default(cuid())
  text        String
  description String   @default("")
  imageId     String?
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId  String
  votes       Vote[]
}

// Uploaded images, stored in the database so local dev and production
// work the same way (no external file storage). Served via /media/[id].
model Media {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

// A free-form suggestion from a recognized member. Unlike votes,
// suggestions are signed: the author's name is shown next to the text.
model Suggestion {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String

  @@index([memberId])
}

// A vote stores no voter identity — fully anonymous.
model Vote {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId   String
}

// A Secret Santa round ("Amigo secreto"), started by the admin. The draw
// happens when the event is created; only one event is active at a time.
// The admin never sees who gives to whom — only each giver does.
model SecretSantaEvent {
  id          String                  @id @default(cuid())
  name        String
  // Free-form note from the admin, e.g. budget or exchange date.
  details     String                  @default("")
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  assignments SecretSantaAssignment[]
  wishlist    WishlistItem[]

  @@index([active])
}

// One drawn pair: giver gives a gift to receiver. Each participant appears
// exactly once as giver and once as receiver within an event.
model SecretSantaAssignment {
  id         String           @id @default(cuid())
  event      SecretSantaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  giver      Member           @relation("giver", fields: [giverId], references: [id], onDelete: Cascade)
  giverId    String
  receiver   Member           @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String

  @@unique([eventId, giverId])
  @@unique([eventId, receiverId])
}

// A link on a member's wishlist for one event. Title and preview image are
// read from the page's Open Graph tags when the link is added; the image is
// copied into Media so it is served from this site.
model WishlistItem {
  id        String           @id @default(cuid())
  url       String
  title     String           @default("")
  imageId   String?
  note      String           @default("")
  createdAt DateTime         @default(now())
  event     SecretSantaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String

  @@index([eventId, memberId])
}
